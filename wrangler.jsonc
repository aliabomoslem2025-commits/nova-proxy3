{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "503d58c7-d904-47dd-b078-dd9b53b7e655","database_name": "nova-proxy2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "07d55d45793240eea3b3850da0723611" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
